# ─────────────────────────────────────────────────────────────
# Grow My Plant — environment variables
#
# The app runs LOCALLY with zero external services using Node's
# built-in SQLite (node:sqlite). For that, you only need:
#   DATABASE_PROVIDER=sqlite
#   SQLITE_PATH=./data/grow-my-plant.db   (created automatically)
#   ADMIN_SECRET=anything-you-choose
#
# To switch to Supabase in production, set:
#   DATABASE_PROVIDER=supabase
#   NEXT_PUBLIC_SUPABASE_URL=...
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...
# and run the SQL in supabase/migrations/0001_init.sql.
# ─────────────────────────────────────────────────────────────

DATABASE_PROVIDER=sqlite

# Local SQLite file (only used when DATABASE_PROVIDER=sqlite)
SQLITE_PATH=./data/grow-my-plant.db

# Required in all modes. Protects the /api/admin routes & simulate endpoint.
ADMIN_SECRET=change-me-in-production

# Public app URL (used in share cards / meta tags / deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Instagram (optional — webhook works only when these are set) ───
INSTAGRAM_VERIFY_TOKEN=your-webhook-verify-token
INSTAGRAM_TARGET_MEDIA_ID=

# App secret (Meta App → Settings → Basic). REQUIRED in production — the
# webhook POST handler rejects any request whose X-Hub-Signature-256 HMAC
# (computed over the raw body with this secret) does not match.
INSTAGRAM_APP_SECRET=

# Public base URL where Meta delivers webhooks (used when subscribing).
# In dev use your ngrok tunnel, e.g. https://abcd1234.ngrok-free.app
# The callback Meta calls is <this>/api/instagram/webhook
INSTAGRAM_WEBHOOK_BASE_URL=

INSTAGRAM_PERMALINK=https://www.instagram.com/

# Optional, outbound-only. A Meta/Instagram Graph API access token (long-lived).
# NOT required for the incoming webhook (that path only uses INSTAGRAM_APP_SECRET).
# Only needed if you later use the Instagram Graph client (e.g. fetchMedia) to
# look up media permalinks/captions. Leave blank to keep the app running token-free.
INSTAGRAM_ACCESS_TOKEN=
